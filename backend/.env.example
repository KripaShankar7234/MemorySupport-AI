# ==============================================================================
# MemorySupport AI - Backend Environment Template (.env.example)
# Copy this file to backend/.env and populate your actual credentials.
# NEVER commit or expose the actual backend/.env file to version control.
# ==============================================================================

# Hindsight Cloud Configuration
# Hosted endpoint: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hs_your_hindsight_api_key_here
HINDSIGHT_BANK_ID=memorysupport-demo

# Groq Cloud Configuration (Fast LLM Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=memorysupport_ai

# Application Server Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
